# academic-research-mcp configuration
#
# Copy this to one of these locations, whichever is more convenient:
#
#   ~/.academic-research-mcp/config.env   (per user)
#   ./.academic-research-mcp.env          (per project)
#
# or point at it explicitly with RESEARCH_MCP_CONFIG=/path/to/config.env
#
# Why a file and not just the environment: several MCP hosts spawn the server with no
# inherited environment, so a value exported in your shell can silently never arrive. The
# file always does.

# Contact address sent to OpenAlex, Crossref and Unpaywall. They route "polite pool"
# traffic by it, and Unpaywall requires it. Free, and only asks who is calling.
RESEARCH_MCP_MAILTO=you@example.org

# Where downloaded PDFs go. Defaults to ~/.academic-research-mcp, with PDFs in papers/
# below it.
# RESEARCH_MCP_STORAGE=/data/papers

# Per-request timeout, seconds.
# RESEARCH_MCP_TIMEOUT=25

# Minimum gap between requests to the same host, seconds. Raising it is polite; lowering it
# is your own risk.
# RESEARCH_MCP_MIN_INTERVAL=0.34

# How long a response is reused before being fetched again, seconds.
# RESEARCH_MCP_CACHE_TTL=300

# stdio (default, for hosts that spawn the server) or streamable-http (for hosts that
# connect over the network, such as dxmie-slide).
# RESEARCH_MCP_TRANSPORT=stdio
